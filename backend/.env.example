# Copy this file to `.env` and fill in real values.
# Never commit `.env` (it contains secrets).

# ==================== ENV ====================
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string

# ==================== DATABASE ====================
# SQLite (dev)
# DB_TYPE=sqlite
# DATABASE_URL=sqlite:///scraper.db

# MySQL (production)
DB_TYPE=mysql
# Accepts either `mysql://...` or `mysql+pymysql://...`
DATABASE_URL=mysql://scraper:your_password@localhost:3306/scraper_db

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==================== COINBASE COMMERCE ====================
COINBASE_API_KEY=...
COINBASE_WEBHOOK_SECRET=...

# ==================== PAYPAL ====================
# Set PAYPAL_ENV=live in production. Use sandbox for development/testing.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ==================== SMTP ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@business-scraper.com

# Public frontend/app URL (used in email templates)
APP_URL=https://app.your-domain.com

# Frontend URL used for payment redirects (Stripe Checkout, PayPal approval/cancel)
FRONTEND_URL=https://infinity-leads.vercel.app

# Optional: override admin notification recipients (comma-separated)
# If omitted, the backend will email all approved admin users.
ADMIN_NOTIFICATION_EMAILS=admin@your-domain.com

# ==================== REDIS / CELERY ====================
REDIS_URL=redis://localhost:6379/0

# Optional: disable default admin bootstrap (recommended in production)
# DISABLE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_EMAIL=akb@tool.com
# DEFAULT_ADMIN_PASSWORD=tool.com
